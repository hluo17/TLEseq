  # ═══════════════ VIEW 5: CELL TYPE & SUBTYPE EXPLORATION ═══════════════
  
  output$sub_explore_main_umap <- renderPlot({
    req(input$view_type == "Cell Type & Subtype Exploration",
        input$sub_explore_main_type)
    build_highlighted_umap(input$sub_explore_main_type, "#2c3e50")
  })
  output$sub_explore_main_spatial <- renderPlot({
    req(input$view_type == "Cell Type & Subtype Exploration",
        input$sub_explore_main_type, input$sub_explore_fov, input$spatial_dot_size)
    build_highlighted_spatial(input$sub_explore_fov, input$sub_explore_main_type,
                              "#2c3e50", input$spatial_dot_size)
  }, res = 144)
  
  output$dynamic_subtype_ui <- renderUI({
    req(input$view_type == "Cell Type & Subtype Exploration",
        input$sub_explore_main_type)
    subs <- subtype_mapping %>%
      dplyr::filter(celltype == input$sub_explore_main_type) %>%
      dplyr::pull(cellsubtype) %>% unique() %>% sort()
    selectInput("sub_explore_subtype", "Select Cell Subtype:", choices = subs)
  })
  
  output$sub_explore_sub_umap <- renderPlot({
    req(input$view_type == "Cell Type & Subtype Exploration",
        input$sub_explore_main_type, input$sub_explore_subtype)
    s_type   <- input$sub_explore_subtype
    all_sub  <- unique(na.omit(as.character(dat$cellsubtype_fine)))
    sub_cols <- setNames(rep("lightgrey", length(all_sub)), all_sub)
    sub_cols[s_type] <- "#c0392b"
    DimPlot(dat, reduction = "umap", group.by = "cellsubtype_fine",
            cols = sub_cols, order = s_type) +
      coord_fixed() + theme_classic() +
      theme(legend.position = "none") + ggtitle(paste("UMAP:", s_type))
  })
  
  output$sub_explore_sub_spatial <- renderPlot({
    req(input$view_type == "Cell Type & Subtype Exploration",
        input$sub_explore_subtype, input$sub_explore_fov, input$spatial_dot_size)
    build_subtype_spatial(input$sub_explore_fov, input$sub_explore_subtype,
                          "#c0392b", input$spatial_dot_size)
  }, res = 144)
}


