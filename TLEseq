#helper function for text box used to display significantly expressed genes
#formats the textbox in a coherent way that allows genes to be clearly displayed
#when downloaded
text_box_grob <- function(header_lines, marker_genes) {
  max_vertical_lines <- 28
  header_text <- paste(header_lines, collapse = "\n")
  
  if (length(marker_genes) > 0) {
    genes_per_col <- 25
    gene_chunks <- split(marker_genes, ceiling(seq_along(marker_genes) / genes_per_col))
    
    max_len <- max(sapply(gene_chunks, length))
    gene_chunks <- lapply(gene_chunks, function(x) {
      c(x, rep("", max_len - length(x)))
    })
    
    gene_matrix <- do.call(cbind, gene_chunks)
    gene_matrix <- apply(gene_matrix, 2, function(col) sprintf("%-10s", col))
    gene_lines  <- apply(gene_matrix, 1, paste, collapse = " ")
    gene_text   <- paste(gene_lines, collapse = "\n")
  } else {
    gene_text <- "  No statistically significant markers calculated."
  }
  
  final_output <- paste(header_text, "\n", gene_text, sep = "\n")
  
  ggplot() +
    annotate("text", x = 0.05, y = 0.95, label = final_output, 
             hjust = 0, vjust = 1, size = 3.5, family = "mono") + 
    theme_void() +
    theme(
      plot.margin      = margin(10, 10, 10, 10),
      panel.background = element_rect(fill = "#fdfdfd", color = "grey80", linewidth = 0.5)
    ) +
    coord_cartesian(xlim = c(0, 1), ylim = c(0, 1), expand = FALSE)
}

#Costume function for image dim plots
ImageDimPlot_clean <- function(object, group.by, cols, fov = NULL, size = 1.2, border.size = NA) {
  p <- Seurat::ImageDimPlot(
    object = object, 
    fov = fov, 
    group.by = group.by, 
    cols = cols, 
    size = size, 
    border.size = border.size
  )
  p + coord_fixed() + theme_void() + 
    theme(
      panel.background = element_rect(fill = "white", color = NA),
      plot.background  = element_rect(fill = "white", color = NA),
      legend.position  = "right"
    )
}

