###############################################################################
# SECTION 8: LOAD PRECOMPUTED DATA & ENRICH WITH CELL IDS                    #
#                                                                             #
# spatial_data is a list of data.frames (one per FOV) with columns x, y,      #
# celltype.  We add a cell_id column (cell barcode) and cellsubtype so that   #
# gene-expression and subtype spatial plots can be built from the same        #
# coordinate data without calling Seurat's fragile ImageDimPlot /             #
# ImageFeaturePlot internals.                                                 #
###############################################################################

precomputed_data <- readRDS("/data/precomputed_app_data.rds")
umap_data    <- precomputed_data$umap_data
spatial_data <- precomputed_data$spatial_data
ilae_lookup  <- precomputed_data$ilae_lookup

# Enrich each FOV's data.frame with cell barcodes and subtype labels.
# The rows in spatial_data[[fov]] are in the same order as the cells whose
# orig.ident matches that FOV, since both were extracted from the same
# Seurat object.
for (.fov in names(spatial_data)) {
  .cells <- colnames(dat)[dat$orig.ident == .fov]
  .df    <- spatial_data[[.fov]]
  if (nrow(.df) == length(.cells)) {
    .df$cell_id      <- .cells
    .df$cellsubtype  <- as.character(dat$cellsubtype_fine[.cells])
    spatial_data[[.fov]] <- .df
  }
}
rm(.fov, .cells, .df)


###############################################################################
# SECTION 9: PLOT HELPER FUNCTIONS                                           #
#                                                                             #
# Every helper returns a plain ggplot — never a patchwork — so they can be    #
# freely combined with patchwork operators in the download handler.           #
#                                                                             #
# All plots use geom_scattermore for speed, with pixels = c(1024, 1024)       #
# for sharp rasterization (the default resolution was what caused blurriness). #
###############################################################################

get_ilae_label <- function(fov) {
  val <- ilae_lookup[fov]
  if (is.null(val) || is.na(val)) "Unknown" else as.character(val)
}

# ── General UMAP (all cells colored by cell type) ──
build_general_umap <- function() {
  cols_umap <- colnames(umap_data)[1:2]
  ggplot(umap_data, aes(.data[[cols_umap[1]]], .data[[cols_umap[2]]], color = celltype)) +
    geom_scattermore(pointsize = 1, alpha = 0.8, pixels = c(1024, 1024)) +
    scale_color_manual(values = pal_celltype) +
    coord_fixed() + theme_classic() +
    theme(plot.title = element_text(hjust = 0.5, face = "bold")) +
    guides(color = guide_legend(override.aes = list(size = 3, alpha = 1)))
}

# ── UMAP with one cell type highlighted ──
build_highlighted_umap <- function(target_type, highlight_color = "#2c3e50") {
  cols_umap <- colnames(umap_data)[1:2]
  df <- umap_data
  df$highlight <- ifelse(df$celltype == target_type, target_type, "other")
  df <- df[order(df$highlight == target_type), ]
  ggplot(df, aes(.data[[cols_umap[1]]], .data[[cols_umap[2]]], color = highlight)) +
    geom_scattermore(pointsize = 1, alpha = 0.8, pixels = c(1024, 1024)) +
    scale_color_manual(values = c("other" = "lightgrey",
                                  setNames(highlight_color, target_type))) +
    coord_fixed() + theme_classic() + theme(legend.position = "none")
}

# ── General spatial plot (one FOV, all cell types) ──
build_general_spatial <- function(fov, dot_size = 1.5) {
  df <- spatial_data[[fov]]
  if (is.null(df))
    return(ggplot() + theme_void() + ggtitle(paste0(fov, ": no data")))
  ilae <- get_ilae_label(fov)
  ggplot(df, aes(x = x, y = y, color = celltype)) +
    geom_scattermore(pointsize = dot_size * 2, alpha = 0.7, pixels = c(1024, 1024)) +
    scale_color_manual(values = pal_celltype) +
    coord_fixed() + theme_void() +
    theme(panel.background = element_rect(fill = "white", color = NA),
          plot.background  = element_rect(fill = "white", color = NA),
          legend.position  = "right") +
    ggtitle(paste0(fov, " ILAE (", ilae, "): General"))
}

