  }, res = 144)
  
  # ═══════════════ VIEW 4: SPATIAL CELL TYPE ═══════════════
  
  output$spatial_ct_plot1 <- renderPlot({
    req(input$view_type == "Spatial Feature Plot (Cell Type)", input$fov_ct1)
    if (input$celltype_select1 == "General") return(build_general_spatial(input$fov_ct1, input$spatial_dot_size))
