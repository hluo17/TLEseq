#This allows all of the possible plots and text boxes generated to be downloaded
#It helps lay out the format of the plots onto a page so that all plots
#Can be clearly displayed
# Master plotting / retrieval function for Shiny UI & Download Handler
make_current_plot <- function(input) {
  
  if (input$view_type == "UMAP + Violin Plot") {
    u1 <- if (input$gene_umap1 == "General") {
      precomputed_general_umap + ggtitle("General UMAP")
    } else {
      FeaturePlot(dat_sub, features = input$gene_umap1, reduction = "umap") + coord_fixed()
    }
    
    b1 <- if (input$gene_umap1 == "General") {
      ggplot() + theme_void()
    } else {
      df1 <- FetchData(dat_sub, vars = c(input$gene_umap1, "celltype"))
      colnames(df1)[1] <- "expr"
      ggplot(df1, aes(x = celltype, y = expr, fill = celltype)) +
        geom_violin(scale = "width", alpha = 0.85, width = 0.6) + 
        scale_fill_manual(values = pal_celltype) +
        theme_classic() + ylab(paste(input$gene_umap1, "Expression"))
    }
    
    u2 <- if (input$gene_umap2 == "General") {
      precomputed_general_umap + ggtitle("General UMAP")
    } else {
      FeaturePlot(dat_sub, features = input$gene_umap2, reduction = "umap") + coord_fixed()
    }
    
    b2 <- if (input$gene_umap2 == "General" || !input$gene_umap2 %in% rownames(dat_sub)) {
      ggplot() + theme_void()
    } else {
      df2 <- FetchData(dat_sub, vars = c(input$gene_umap2, "celltype"))
      colnames(df2)[1] <- "expr"
      ggplot(df2, aes(x = celltype, y = expr, fill = celltype)) +
        geom_violin(scale = "width", alpha = 0.85, width = 0.6) + 
        scale_fill_manual(values = pal_celltype) +
        theme_classic() + ylab(paste(input$gene_umap2, "Expression"))
    }
    
    return((u1 / b1) | (u2 / b2)) + plot_layout(heights = c(5, 3))
  } 
  
  else if (input$view_type == "UMAP Cluster Selection") {
    u_plot <- DimPlot(dat_sub, reduction = "umap", group.by = "celltype", cols = pal_celltype) + 
      coord_fixed() + ggtitle("General UMAP Layout")
    
    cluster_id <- input$selected_cluster_drop
    mapped_type <- cluster_mapping %>% 
      filter(seurat_clusters == cluster_id) %>% 
      pull(celltype)
    
    header_lines <- c(
      "Cluster Analysis",
      "=============================================",
      paste("Selected Cluster ID:", cluster_id),
      paste("Assigned Cell Type :", as.character(mapped_type)),
      "---------------------------------------------",
      "Statistically Significant Markers (p_val_adj < 0.05):"
    )
    
    marker_genes <- if (cluster_id %in% names(marker_list)) {
      marker_list[[cluster_id]]
    } else {
      character(0)
    }
    
    t_plot <- text_box_grob(header_lines, marker_genes)
    
    return(u_plot + t_plot + plot_layout(widths = c(6.5, 3.5)))
  }
  
  else if (input$view_type == "Spatial Feature Plot (Gene Expression)") {
    get_ilae_local <- function(fov) {
      df_sub <- dat@meta.data[dat@meta.data$orig.ident == fov, ]
      if(nrow(df_sub) == 0) return("Unknown")
      val <- unique(df_sub$ILAE_score)[1]
      return(ifelse(is.na(val), "Unknown", as.character(val)))
    }
    
    max_gene1 <- if (input$gene_spatial1 != "General") gene_max_df[input$gene_spatial1, "max_val"] else 0
    max_gene2 <- if (input$gene_spatial2 != "General") gene_max_df[input$gene_spatial2, "max_val"] else 0
    global_max_val <- max(c(max_gene1, max_gene2, 0.1), na.rm = TRUE)
    
    get_gene_spatial_plot <- function(fov, gene_sel) {
      ilae_val <- get_ilae_local(fov)
      if (gene_sel == "General") {
        return(ImageDimPlot_clean(dat, fov = fov, group.by = "celltype", cols = pal_celltype, size = input$spatial_dot_size, border.size = NA) + 
                 ggtitle(paste0(fov, " ILAE (", ilae_val, "): General")))
      } else {
        # Using the new custom ordered function to enforce high expression on top
        p <- ImageFeaturePlot_ordered(
          object = dat, 
          fov = fov, 
          features = gene_sel, 
          size = input$spatial_dot_size, 
          border.size = NA,
          order = TRUE
        ) + 
          coord_fixed() + theme_void() + 
          theme(panel.background = element_rect(fill = "white", color = NA)) +
          ggtitle(paste0(fov, " ILAE (", ilae_val, "): ", gene_sel))
        
        p <- suppressMessages(
          p + scale_fill_gradientn(colors = c("lightgrey", "firebrick1"), limits = c(0, global_max_val))
        )
        return(p)
      }
    }
    
    return(get_gene_spatial_plot(input$fov1, input$gene_spatial1) + 
             get_gene_spatial_plot(input$fov2, input$gene_spatial2))
  }
  
  else if (input$view_type == "Spatial Feature Plot (Cell Type)") {
    get_ct_plot <- function(fov, sel) {
      df_sub <- dat@meta.data[dat@meta.data$orig.ident == fov, ]
      ilae_val <- if(nrow(df_sub) > 0) unique(df_sub$ILAE_score)[1] else "Unknown"
      
      if (sel == "General") {
        return(ImageDimPlot_clean(dat, fov = fov, group.by = "celltype", cols = pal_celltype, size = input$spatial_dot_size, border.size = NA) + 
                 ggtitle(paste0(fov, " ILAE (", ilae_val, "): General")))
      } else {
        all_types <- levels(dat$celltype)
        custom_pal <- setNames(rep("lightgrey", length(all_types)), all_types)
        custom_pal[sel] <- "firebrick1"
        
        cells_in_fov <- colnames(dat)[dat$orig.ident == fov]
        is_target <- dat$celltype[cells_in_fov] == sel
        ordered_cells <- c(cells_in_fov[!is_target], cells_in_fov[is_target])
        
        return(ImageDimPlot(dat, fov = fov, group.by = "celltype", cols = custom_pal, size = input$spatial_dot_size, border.size = NA, cells = ordered_cells) + 
                 coord_fixed() + theme_void() + 
                 theme(panel.background = element_rect(fill = "white", color = NA)) +
                 ggtitle(paste0(fov, " ILAE (", ilae_val, "): ", sel)))
      }
    }
    return(get_ct_plot(input$fov_ct1, input$celltype_select1) + get_ct_plot(input$fov_ct2, input$celltype_select2))
  }
  
  else if (input$view_type == "Cell Type & Subtype Exploration") {
    req(input$sub_explore_main_type, input$sub_explore_subtype, input$sub_explore_fov)
    
    p1 <- precomputed_main_umaps[[input$sub_explore_main_type]] + 
      ggtitle(paste("UMAP:", input$sub_explore_main_type)) + theme_void()
    
    all_types <- levels(dat_sub$celltype)
    p1_cols <- setNames(rep("lightgrey", length(all_types)), all_types)
    p1_cols[input$sub_explore_main_type] <- "#2c3e50"
    
    cells_in_fov <- colnames(dat)[dat$orig.ident == input$sub_explore_fov]
    is_target_main <- dat$celltype[cells_in_fov] == input$sub_explore_main_type
    ordered_cells_main <- c(cells_in_fov[!is_target_main], cells_in_fov[is_target_main])
    
    p2 <- ImageDimPlot(dat, fov = input$sub_explore_fov, group.by = "celltype", cols = p1_cols, size = input$spatial_dot_size, border.size = NA, cells = ordered_cells_main) + 
      coord_fixed() + theme_void() + ggtitle(paste("Spatial:", input$sub_explore_main_type))
    
    p3 <- precomputed_sub_umaps[[input$sub_explore_subtype]] + 
      ggtitle(paste("UMAP:", input$sub_explore_subtype)) + theme_void()
    
    all_subtypes <- unique(as.character(dat_sub$cellsubtype))
    p3_cols <- setNames(rep("lightgrey", length(all_subtypes)), all_subtypes)
    p3_cols[input$sub_explore_subtype] <- "#c0392b"
    
    is_target_sub <- dat$cellsubtype[cells_in_fov] == input$sub_explore_subtype
    ordered_cells_sub <- c(cells_in_fov[!is_target_sub], cells_in_fov[is_target_sub])
    
    p4 <- ImageDimPlot(dat, fov = input$sub_explore_fov, group.by = "cellsubtype", cols = p3_cols, size = input$spatial_dot_size, border.size = NA, cells = ordered_cells_sub) + 
      coord_fixed() + theme_void() + ggtitle(paste("Spatial:", input$sub_explore_subtype)) +
      theme(legend.position = "none")
    
    return((p1 + p3) / (p2 + p4))
  }
  
  else {
    return(DimPlot(dat_sub, reduction = "umap", group.by = "celltype", cols = pal_celltype) + 
             coord_fixed() + ggtitle("General UMAP Layout"))
  }
}

