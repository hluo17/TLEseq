server <- function(input, output, session) {
  
  is_valid_gene <- function(x) {
    !is.null(x) && length(x) == 1 && nzchar(trimws(x)) &&
      trimws(x) != "General" && x %in% genes
  }
  
  # ── Download ──
  output$download_plot <- downloadHandler(
    filename = function() paste0("TLEseq_plot_", Sys.Date(), ".pdf"),
    content  = function(file) {
      p <- make_current_plot(input)
      ggplot2::ggsave(file, plot = p, device = grDevices::cairo_pdf,
                      width = 11, height = 8.5)
    })
  
  # ── Shared reactive: global expression ceiling for spatial gene plots ──
  global_spatial_max <- reactive({
    req(input$gene_spatial1, input$gene_spatial2)
    gmax <- function(g) {
      if (g == "General" || !(g %in% genes)) return(0)
      max(GetAssayData(dat, assay = "Xenium", layer = "data")[g, ])
    }
    max(c(gmax(input$gene_spatial1), gmax(input$gene_spatial2), 0.1), na.rm = TRUE)
  })
  
  expr_data1 <- reactive({
    req(input$view_type == "UMAP + Violin Plot", is_valid_gene(input$gene_umap1))
    df <- FetchData(dat, vars = c(input$gene_umap1, "celltype"))
    colnames(df)[1] <- "expr"; df
  })
  expr_data2 <- reactive({
    req(input$view_type == "UMAP + Violin Plot", is_valid_gene(input$gene_umap2))
    df <- FetchData(dat, vars = c(input$gene_umap2, "celltype"))
    colnames(df)[1] <- "expr"; df
  })
  
  # ═══════════════ VIEW 1: UMAP + VIOLIN PLOT ═══════════════
  
  output$plot <- renderPlot({
    req(input$view_type == "UMAP + Violin Plot")
    if (input$gene_umap1 == "General") build_general_umap()
    else FeaturePlot(dat, features = input$gene_umap1, reduction = "umap") +
      coord_fixed() + labs(color = "Normalized\nExpression")
  })
  output$plot2 <- renderPlot({
    req(input$view_type == "UMAP + Violin Plot")
    if (input$gene_umap2 == "General") build_general_umap()
    else FeaturePlot(dat, features = input$gene_umap2, reduction = "umap") +
      coord_fixed() + labs(color = "Normalized\nExpression")
  })
  output$violinplot1 <- renderPlot({
    req(input$view_type == "UMAP + Violin Plot")
    if (input$gene_umap1 == "General") return(NULL)
    df <- expr_data1()
    ggplot(df, aes(celltype, expr, fill = celltype)) +
      geom_violin(scale = "width", alpha = 0.85, width = 0.6) +
      scale_fill_manual(values = pal_celltype) + theme_classic() +
      ylab(paste(input$gene_umap1, "Expression"))
  })
  output$violinplot2 <- renderPlot({
    req(input$view_type == "UMAP + Violin Plot")
    if (input$gene_umap2 == "General") return(NULL)
    df <- expr_data2()
    ggplot(df, aes(celltype, expr, fill = celltype)) +
      geom_violin(scale = "width", alpha = 0.85, width = 0.6) +
      scale_fill_manual(values = pal_celltype) + theme_classic() +
      ylab(paste(input$gene_umap2, "Expression"))
  })
  
  # ═══════════════ VIEW 2: UMAP CLUSTER SELECTION ═══════════════
  
  output$cluster_select_plot <- renderPlot({
    req(input$view_type == "UMAP Cluster Selection")
    build_general_umap()
  })
  output$cluster_info_box <- renderPrint({
    req(input$view_type == "UMAP Cluster Selection", input$selected_cluster_drop)
    cid <- input$selected_cluster_drop
    ct  <- cluster_mapping %>%
      dplyr::filter(seurat_clusters == cid) %>% dplyr::pull(celltype)
    cat("Selected Cluster ID:", cid, "\n")
    cat("Assigned Cell Type :", as.character(ct), "\n")
    cat("---------------------------------------------\n")
    if (cid %in% names(marker_list)) {
      cat("Statistically Significant Markers (p_val_adj < 0.05):\n")
      cat(paste0("   \u2022 ", marker_list[[cid]], collapse = "\n"))
    } else {
      cat("No statistically significant markers calculated for this cluster.")
    }
  })
  
  # ═══════════════ VIEW 3: SPATIAL GENE EXPRESSION ═══════════════
  
  output$spatial_plot1 <- renderPlot({
    req(input$view_type == "Spatial Feature Plot (Gene Expression)",
        input$fov1, input$gene_spatial1)
    if (input$gene_spatial1 == "General") return(build_general_spatial(input$fov1, input$spatial_dot_size))
    req(input$spatial_dot_size)
    build_gene_spatial(input$fov1, input$gene_spatial1,
                       input$spatial_dot_size, global_spatial_max())
  }, res = 144)
  output$spatial_plot2 <- renderPlot({
    req(input$view_type == "Spatial Feature Plot (Gene Expression)",
        input$fov2, input$gene_spatial2)
