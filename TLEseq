  df <- spatial_data[[fov]]
  if (is.null(df))
    return(ggplot() + theme_void() + ggtitle(paste0(fov, ": no data")))
  ilae <- get_ilae_label(fov)
  df$highlight <- ifelse(df$celltype == target_type, target_type, "other")
  df <- df[order(df$highlight == target_type), ]
  ggplot(df, aes(x = x, y = y, color = highlight)) +
    geom_scattermore(pointsize = dot_size * 2, pixels = c(1024, 1024)) +
    scale_color_manual(values = c("other" = "lightgrey",
                                  setNames(highlight_color, target_type))) +
    coord_fixed() + theme_void() +
    theme(legend.position = "none",
          panel.background = element_rect(fill = "white", color = NA)) +
    ggtitle(paste0(fov, " ILAE (", ilae, "): ", target_type))
}

# ── Spatial gene-expression plot (replaces ImageFeaturePlot_ordered) ──
# Plots expression of one gene on one FOV using the enriched spatial_data,
# with high-expressing cells drawn on top.
build_gene_spatial <- function(fov, gene, dot_size = 1.0, max_expr = NULL) {
  df <- spatial_data[[fov]]
  if (is.null(df) || !"cell_id" %in% colnames(df))
    return(ggplot() + theme_void() + ggtitle(paste0(fov, ": no data")))
  
  expr_vec <- GetAssayData(dat, assay = "Xenium", layer = "data")[gene, df$cell_id]
  df$expr  <- as.numeric(expr_vec)
  df <- df[order(df$expr), ]                      # low first → high on top
  
  if (is.null(max_expr)) max_expr <- max(df$expr, na.rm = TRUE)
  if (max_expr == 0) max_expr <- 1
  ilae <- get_ilae_label(fov)
  
  ggplot(df, aes(x = x, y = y, color = expr)) +
    geom_scattermore(pointsize = dot_size * 2, alpha = 0.7, pixels = c(1024, 1024)) +
    scale_color_gradient(low = "lightgrey", high = "firebrick1",
                         limits = c(0, max_expr),
                         name = paste0(gene, "\nNormalized\nExpression")) +
    coord_fixed() + theme_void() +
    theme(panel.background = element_rect(fill = "white", color = NA),
          plot.background  = element_rect(fill = "white", color = NA),
          legend.position  = "right") +
    ggtitle(paste0(fov, " ILAE (", ilae, "): ", gene))
}

# ── Spatial subtype-highlight plot (replaces ImageDimPlot_ordered) ──
# Highlights one cellsubtype_fine value against a grey background.
build_subtype_spatial <- function(fov, target_subtype,
                                  highlight_color = "#c0392b",
                                  dot_size = 1.0) {
  df <- spatial_data[[fov]]
  if (is.null(df) || !"cellsubtype" %in% colnames(df))
    return(ggplot() + theme_void() + ggtitle(paste0(fov, ": no data")))
  
  ilae <- get_ilae_label(fov)
  df$highlight <- ifelse(df$cellsubtype == target_subtype, target_subtype, "other")
  if (!any(df$highlight == target_subtype))
    return(ggplot() + theme_void() +
             ggtitle(paste0("No '", target_subtype, "' cells in ", fov)))
  df <- df[order(df$highlight == target_subtype), ]

  ggplot(df, aes(x = x, y = y, color = highlight)) +
    geom_scattermore(pointsize = dot_size * 2, pixels = c(1024, 1024)) +
    scale_color_manual(values = c("other" = "lightgrey",
                                  setNames(highlight_color, target_subtype))) +
    coord_fixed() + theme_void() +
    theme(legend.position = "none",
          panel.background = element_rect(fill = "white", color = NA)) +
    ggtitle(paste0(fov, " ILAE (", ilae, "): ", target_subtype))
}


