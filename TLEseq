server <- function(input, output, session) {
  
  #TESTER --> used to test the amount of RAM needed for the shiny app
  #NOTE: delete this section before publishing the website
  output$ram_usage <- renderText({
    invalidateLater(5000, session)
    mem <- gc(verbose = FALSE)
    used_mb <- sum(mem[, "used"] * c(56, 8)) / 1024^2
    paste0("🖥️ System Memory In Use: ", round(used_mb, 1), " MB")
  })
  
  #Makes sure the gene inputted is valid
  #helps avoid website crashes when plotting
  is_valid_gene <- function(x, dat) {
    !is.null(x) && length(x) == 1 && trimws(x) != "" && trimws(x) != "General" && x %in% rownames(dat)
  }
  
  #Allows the plots to be saved
  output$download_plot <- downloadHandler(
    filename = function() { paste0("Seurat_plot_", Sys.Date(), ".pdf") },
    content = function(file) {
      p <- make_current_plot(input)
      ggplot2::ggsave(filename = file, plot = p, device = grDevices::cairo_pdf, width = 11, height = 8.5)
    }
  )
  
  #gets ILAE grade of the selected FOV
  #Displays the ILAE grade above the plotted spatial plot
  get_ilae <- function(fov) {
    df_sub <- dat@meta.data[dat@meta.data$orig.ident == fov, ]
    if(nrow(df_sub) == 0) return("Unknown")
    ilae <- unique(df_sub$ILAE_score)[1]
    if (is.null(ilae) || is.na(ilae)) return("Unknown")
    return(as.character(ilae))
  }
  
  #Takes the two selected genes for spatial feature plotting
  #Calculates their gene expression and syncs their scal bars
  #So that the spatial plots are comparable
  global_spatial_max <- reactive({
    req(input$gene_spatial1, input$gene_spatial2)
    val1 <- if (input$gene_spatial1 != "General") gene_max_df[input$gene_spatial1, "max_val"] else 0
    val2 <- if (input$gene_spatial2 != "General") gene_max_df[input$gene_spatial2, "max_val"] else 0
    max(c(val1, val2, 0.1), na.rm = TRUE) 
  })
  
  #generates the first UMAP for UMap + violin plot
  #The general UMAP will automatically be generated, but will be replaced by
  #A feature UMAP once a gene has been selected
  output$plot <- renderPlot({
    req(input$view_type == "UMAP + Violin Plot")
    if (input$gene_umap1 == "General") {
      DimPlot(dat_sub, reduction = "umap", group.by = "celltype", cols = pal_celltype) + coord_fixed()
    } else {
      FeaturePlot(dat_sub, features = input$gene_umap1, reduction = "umap") + coord_fixed()
    }
  })
  
  #generates the second UMAP for UMap + violin plot
  output$plot2 <- renderPlot({
    req(input$view_type == "UMAP + Violin Plot")
    if (input$gene_umap2 == "General") {
      DimPlot(dat_sub, reduction = "umap", group.by = "celltype", cols = pal_celltype) + coord_fixed()
    } else {
      FeaturePlot(dat_sub, features = input$gene_umap2, reduction = "umap") + coord_fixed()
    }
  })
  
  #generates the first violin plot for UMAP +  violin plot
  output$violinplot1 <- renderPlot({
    req(input$view_type == "UMAP + Violin Plot")
    if (input$gene_umap1 == "General") return(NULL)
    df <- FetchData(dat_sub, vars = c(input$gene_umap1, "celltype"))
    colnames(df)[1] <- "expr"
    ggplot(df, aes(x = celltype, y = expr, fill = celltype)) + 
      geom_violin(scale = "width", alpha = 0.85, width = 0.6) + 
      scale_fill_manual(values = pal_celltype) + 
      theme_classic() + ylab(paste(input$gene_umap1, "Expression"))
  })
  
  #generates the second violin plot for UMAP +  violin plot
  output$violinplot2 <- renderPlot({
    req(input$view_type == "UMAP + Violin Plot")
    if (!is_valid_gene(input$gene_umap2, dat_sub)) return(NULL)
    df <- FetchData(dat_sub, vars = c(input$gene_umap2, "celltype"))
    colnames(df)[1] <- "expr"
    ggplot(df, aes(x = celltype, y = expr, fill = celltype)) + 
      geom_violin(scale = "width", alpha = 0.85, width = 0.6) + 
      scale_fill_manual(values = pal_celltype) + 
      theme_classic() + ylab(paste(input$gene_umap2, "Expression"))
  })
  
  #generates the general UMAP in UMAP cluster selection
  output$cluster_select_plot <- renderPlot({
    req(input$view_type == "UMAP Cluster Selection")
    DimPlot(dat_sub, reduction = "umap", group.by = "celltype", cols = pal_celltype) + 
      coord_fixed() + ggtitle("General UMAP Layout")
  })
  
  #Generates the cluster info box in UMAP cluster selection
  output$cluster_info_box <- renderPrint({
    req(input$view_type == "UMAP Cluster Selection", input$selected_cluster_drop)
    cluster_id  <- input$selected_cluster_drop
    mapped_type <- cluster_mapping %>% filter(seurat_clusters == cluster_id) %>% pull(celltype)
    cat("Selected Cluster ID:", cluster_id, "\n")
    cat("Assigned Cell Type :", as.character(mapped_type), "\n")
    cat("---------------------------------------------\n")
    if (cluster_id %in% names(marker_list)) {
      cat("Statistically Significant Markers (p_val_adj < 0.05):\n")
      cat(paste0("  • ", marker_list[[cluster_id]], collapse = "\n"))
    } else {
      cat("No statistically significant markers calculated for this cluster.")
    }
  })
  
  #generates the first spatial plot for spatial plot (gene expression)
  #The general spatial plot will automatically be generated, but will be replaced by
  #A feature UMAP once a gene has been selected
  #The user must also select a FOV
  output$spatial_plot1 <- renderPlot({
    req(input$view_type == "Spatial Feature Plot (Gene Expression)", input$fov1, input$gene_spatial1)
    if (input$gene_spatial1 == "General") {
      return(precomputed_general_plots[[input$fov1]])
    } else {
      req(input$spatial_dot_size)
      ilae_val <- get_ilae(input$fov1)
      
      expr_vals <- FetchData(dat, vars = input$gene_spatial1)[, 1]
      cells_in_fov <- colnames(dat)[dat$orig.ident == input$fov1]
      fov_expr <- expr_vals[cells_in_fov]
      ordered_cells <- cells_in_fov[order(fov_expr, decreasing = FALSE)]
      
      # Swapped ImageFeaturePlot to ImageFeaturePlot_ordered with order = TRUE
      p <- ImageFeaturePlot_ordered(dat, fov = input$fov1, features = input$gene_spatial1, size = input$spatial_dot_size, cells = ordered_cells, order = TRUE) +
        coord_fixed() + theme_void() + 
        theme(panel.background = element_rect(fill = "white", color = NA)) +
        ggtitle(paste0(input$fov1, " ILAE (", ilae_val, "): ", input$gene_spatial1))
      
      p <- suppressMessages(p + scale_fill_gradientn(colors = c("lightgrey", "firebrick1"), limits = c(0, global_spatial_max())))
      return(p)
    }
  })
  
  #generates the second spatial plot for spatial plot (gene expression)
  output$spatial_plot2 <- renderPlot({
    req(input$view_type == "Spatial Feature Plot (Gene Expression)", input$fov2, input$gene_spatial2)
    if (input$gene_spatial2 == "General") {
      return(precomputed_general_plots[[input$fov2]])
    } else {
      req(input$spatial_dot_size)
      ilae_val = get_ilae(input$fov2)
      
      expr_vals <- FetchData(dat, vars = input$gene_spatial2)[, 1]
      cells_in_fov <- colnames(dat)[dat$orig.ident == input$fov2]
      fov_expr <- expr_vals[cells_in_fov]
      ordered_cells <- cells_in_fov[order(fov_expr, decreasing = FALSE)]
      
      # Swapped ImageFeaturePlot to ImageFeaturePlot_ordered with order = TRUE
      p <- ImageFeaturePlot_ordered(dat, fov = input$fov2, features = input$gene_spatial2, size = input$spatial_dot_size, cells = ordered_cells, order = TRUE) +
        coord_fixed() + theme_void() + 
        theme(panel.background = element_rect(fill = "white", color = NA)) +
        ggtitle(paste0(input$fov2, " ILAE (", ilae_val, "): ", input$gene_spatial2))
      
      p <- suppressMessages(p + scale_fill_gradientn(colors = c("lightgrey", "firebrick1"), limits = c(0, global_spatial_max())))
      return(p)
    }
  })
  
  #generates the first spatial plot for spatial plot (cell type)
  #Uses the same process as the above spatial plotting,
  #except this uses cell type instead of gene expression
  output$spatial_ct_plot1 <- renderPlot({
    req(input$view_type == "Spatial Feature Plot (Cell Type)", input$fov_ct1)
    label_text <- if(input$celltype_select1 == "General") "General" else input$celltype_select1
    if (input$celltype_select1 == "General") {
      return(precomputed_general_plots[[input$fov_ct1]])
    } else {
      req(input$spatial_dot_size)
      ilae_val  = get_ilae(input$fov_ct1)
      all_types <- levels(dat$celltype)
      custom_pal <- setNames(rep("lightgrey", length(all_types)), all_types)
      custom_pal[input$celltype_select1] <- "firebrick1"
      
      cells_in_fov <- colnames(dat)[dat$orig.ident == input$fov_ct1]
      is_target <- dat$celltype[cells_in_fov] == input$celltype_select1
      ordered_cells <- c(cells_in_fov[!is_target], cells_in_fov[is_target])
      
      ImageDimPlot(dat, fov = input$fov_ct1, group.by = "celltype", cols = custom_pal, size = input$spatial_dot_size, cells = ordered_cells) + 
        coord_fixed() + theme_void() + ggtitle(paste0(input$fov_ct1, " ILAE (", ilae_val, "): ", label_text))
    }
  })
  
  #generates the second spatial plot for spatial plot (cell type)
  output$spatial_ct_plot2 <- renderPlot({
    req(input$view_type == "Spatial Feature Plot (Cell Type)", input$fov_ct2)
    label_text <- if(input$celltype_select2 == "General") "General" else input$celltype_select2
    if (input$celltype_select2 == "General") {
      return(precomputed_general_plots[[input$fov_ct2]])
    } else {
      req(input$spatial_dot_size)
      ilae_val  <- get_ilae(input$fov_ct2)
      all_types <- levels(dat$celltype)
      custom_pal <- setNames(rep("lightgrey", length(all_types)), all_types)
      custom_pal[input$celltype_select2] <- "firebrick1"
      
      cells_in_fov <- colnames(dat)[dat$orig.ident == input$fov_ct2]
      is_target <- dat$celltype[cells_in_fov] == input$celltype_select2
      ordered_cells <- c(cells_in_fov[!is_target], cells_in_fov[is_target])
      
      ImageDimPlot(dat, fov = input$fov_ct2, group.by = "celltype", cols = custom_pal, size = input$spatial_dot_size, cells = ordered_cells) + 
        coord_fixed() + theme_void() + theme(panel.background = element_rect(fill = "white", color = NA)) +
        ggtitle(paste0(input$fov_ct2, " ILAE (", ilae_val, "): ", label_text))
    }
  })
  
  #Generates the precomputed feature UMAP for cell type
  output$sub_explore_main_umap <- renderPlot({
    req(input$view_type == "Cell Type & Subtype Exploration", input$sub_explore_main_type)
    precomputed_main_umaps[[input$sub_explore_main_type]]
  })
  
  #Generates the feature spatial plots for cell type
  output$sub_explore_main_spatial <- renderPlot({
    req(input$view_type == "Cell Type & Subtype Exploration", input$sub_explore_main_type, input$sub_explore_fov, input$spatial_dot_size)
    all_types <- levels(dat$celltype)
    custom_colors <- setNames(rep("lightgrey", length(all_types)), all_types)
    custom_colors[input$sub_explore_main_type] <- "#2c3e50"
    ilae_val <- get_ilae(input$sub_explore_fov)
    
    cells_in_fov <- colnames(dat)[dat$orig.ident == input$sub_explore_fov]
    is_target <- dat$celltype[cells_in_fov] == input$sub_explore_main_type
    ordered_cells <- c(cells_in_fov[!is_target], cells_in_fov[is_target])
    
    ImageDimPlot(dat, fov = input$sub_explore_fov, group.by = "celltype", cols = custom_colors, size = input$spatial_dot_size, cells = ordered_cells) + 
      coord_fixed() + theme_void() + 
      ggtitle(paste0(input$sub_explore_fov, " (", ilae_val, ") - ", input$sub_explore_main_type))
  })
  
  #Allows the cell subtype dropdown menu to appear after the general
  #Cell type has been selected
  output$dynamic_subtype_ui <- renderUI({
    req(input$view_type == "Cell Type & Subtype Exploration", input$sub_explore_main_type)
    
    available_subtypes <- subtype_mapping %>%
      filter(celltype == input$sub_explore_main_type) %>%
      pull(cellsubtype)
    
    selectInput("sub_explore_subtype", "Select Cell Subtype:", 
                choices = sort(available_subtypes))
  })
  
  #Generates the precomputed feature UMAP for cell subtype
  output$sub_explore_sub_umap <- renderPlot({
    req(input$view_type == "Cell Type & Subtype Exploration", input$sub_explore_subtype)
    precomputed_sub_umaps[[input$sub_explore_subtype]]
  })
  
  #Generates the feature spatial plots for cell subtype
  output$sub_explore_sub_spatial <- renderPlot({
    req(input$view_type == "Cell Type & Subtype Exploration", input$sub_explore_subtype, input$sub_explore_fov, input$spatial_dot_size)
    all_subtypes <- unique(as.character(dat$cellsubtype))
    custom_colors <- setNames(rep("lightgrey", length(all_subtypes)), all_subtypes)
    custom_colors[input$sub_explore_subtype] <- "#c0392b"
    ilae_val <- get_ilae(input$sub_explore_fov)
    
    cells_in_fov <- colnames(dat)[dat$orig.ident == input$sub_explore_fov]
    is_target <- dat$cellsubtype[cells_in_fov] == input$sub_explore_subtype
    ordered_cells <- c(cells_in_fov[!is_target], cells_in_fov[is_target])
    
    ImageDimPlot(dat, fov = input$sub_explore_fov, group.by = "cellsubtype", cols = custom_colors, size = input$spatial_dot_size, cells = ordered_cells) + 
      coord_fixed() + theme_void() + 
      ggtitle(paste0(input$sub_explore_fov, " (", ilae_val, ") - ", input$sub_explore_subtype)) +
      theme(legend.position = "none")
  })
}

