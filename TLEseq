# make_current_plot() returns a single ggplot or patchwork for every view.    #
# All spatial helpers now return plain ggplots, so patchwork combining works.  #
###############################################################################

make_current_plot <- function(input) {
  
  # ---------- VIEW 1: UMAP + Violin Plot ----------
  if (input$view_type == "UMAP + Violin Plot") {
    
    u1 <- if (input$gene_umap1 == "General") {
      build_general_umap() + ggtitle("General UMAP")
    } else {
      FeaturePlot(dat, features = input$gene_umap1, reduction = "umap") +
        coord_fixed() + labs(color = "Normalized\nExpression")
    }
    b1 <- if (input$gene_umap1 == "General") {
      ggplot() + theme_void()
    } else {
      df1 <- FetchData(dat, vars = c(input$gene_umap1, "celltype"))
      colnames(df1)[1] <- "expr"
      ggplot(df1, aes(x = celltype, y = expr, fill = celltype)) +
        geom_violin(scale = "width", alpha = 0.85, width = 0.6) +
        scale_fill_manual(values = pal_celltype) + theme_classic() +
        ylab(paste(input$gene_umap1, "Expression"))
    }
    u2 <- if (input$gene_umap2 == "General") {
      build_general_umap() + ggtitle("General UMAP")
    } else {
      FeaturePlot(dat, features = input$gene_umap2, reduction = "umap") +
        coord_fixed() + labs(color = "Normalized\nExpression")
    }
    b2 <- if (input$gene_umap2 == "General" || !input$gene_umap2 %in% rownames(dat)) {
      ggplot() + theme_void()
    } else {
      df2 <- FetchData(dat, vars = c(input$gene_umap2, "celltype"))
      colnames(df2)[1] <- "expr"
      ggplot(df2, aes(x = celltype, y = expr, fill = celltype)) +
        geom_violin(scale = "width", alpha = 0.85, width = 0.6) +
        scale_fill_manual(values = pal_celltype) + theme_classic() +
        ylab(paste(input$gene_umap2, "Expression"))
    }
    left  <- wrap_plots(u1, b1, ncol = 1, heights = c(5, 3))
    right <- wrap_plots(u2, b2, ncol = 1, heights = c(5, 3))
    return(wrap_plots(left, right, ncol = 2))
    
    # ---------- VIEW 2: UMAP Cluster Selection ----------
  } else if (input$view_type == "UMAP Cluster Selection") {
    
    u_plot     <- build_general_umap() + ggtitle("General UMAP Layout")
    cluster_id <- input$selected_cluster_drop
    mapped_type <- cluster_mapping %>%
      dplyr::filter(seurat_clusters == cluster_id) %>% dplyr::pull(celltype)
    header <- c("Cluster Analysis",
                "=============================================",
                paste("Selected Cluster ID:", cluster_id),
                paste("Assigned Cell Type :", as.character(mapped_type)),
                "---------------------------------------------",
                "Statistically Significant Markers (p_val_adj < 0.05):")
    mg <- if (cluster_id %in% names(marker_list)) marker_list[[cluster_id]] else character(0)
    return(u_plot + text_box_grob(header, mg) + plot_layout(widths = c(6.5, 3.5)))
    
    # ---------- VIEW 3: Spatial Gene Expression ----------
  } else if (input$view_type == "Spatial Feature Plot (Gene Expression)") {
    
    dot_sz <- if (!is.null(input$spatial_dot_size)) input$spatial_dot_size else 1
    # Compute shared expression ceiling across both genes
    gene_max <- function(g) {
      if (g == "General" || !(g %in% rownames(dat))) return(0)
      max(GetAssayData(dat, assay = "Xenium", layer = "data")[g, ])
    }
    shared_max <- max(c(gene_max(input$gene_spatial1),
                        gene_max(input$gene_spatial2), 0.1), na.rm = TRUE)
    
    sp <- function(fov, gene) {
      if (gene == "General") return(build_general_spatial(fov, dot_sz))
      build_gene_spatial(fov, gene, dot_sz, max_expr = shared_max)
    }
    return(sp(input$fov1, input$gene_spatial1) +
             sp(input$fov2, input$gene_spatial2) +
             plot_layout(ncol = 2))
    
    # ---------- VIEW 4: Spatial Cell Type ----------
  } else if (input$view_type == "Spatial Feature Plot (Cell Type)") {
    
    dot_sz <- if (!is.null(input$spatial_dot_size)) input$spatial_dot_size else 1
    ct <- function(fov, sel) {
      if (sel == "General") return(build_general_spatial(fov, dot_sz))
      build_highlighted_spatial(fov, sel, "firebrick1", dot_sz)
    }
    return(ct(input$fov_ct1, input$celltype_select1) +
             ct(input$fov_ct2, input$celltype_select2) +
             plot_layout(ncol = 2))
    
    # ---------- VIEW 5: Cell Type & Subtype Exploration ----------
  } else if (input$view_type == "Cell Type & Subtype Exploration") {
    
    main_type <- input$sub_explore_main_type
    s_type    <- input$sub_explore_subtype
    fov_sel   <- input$sub_explore_fov
    dot_sz    <- if (!is.null(input$spatial_dot_size)) input$spatial_dot_size else 1
    if (is.null(main_type) || is.null(s_type) || is.null(fov_sel) || fov_sel == "")
      return(ggplot() + theme_void() + ggtitle("Select parameters"))
    
    p1 <- build_highlighted_umap(main_type, "#2c3e50")
    p2 <- build_highlighted_spatial(fov_sel, main_type, "#2c3e50", dot_sz)
    
    # Subtype UMAP (still use DimPlot — it returns a proper ggplot)
    all_sub <- unique(na.omit(as.character(dat$cellsubtype_fine)))
    sub_cols <- setNames(rep("lightgrey", length(all_sub)), all_sub)
    sub_cols[s_type] <- "#c0392b"
    p3 <- DimPlot(dat, reduction = "umap", group.by = "cellsubtype_fine",
                  cols = sub_cols, order = s_type) +
      coord_fixed() + theme_classic() +
      theme(legend.position = "none") + ggtitle(paste("UMAP:", s_type))

    # Subtype spatial — uses new helper, no ImageDimPlot
    p4 <- build_subtype_spatial(fov_sel, s_type, "#c0392b", dot_sz)
    
    return((p1 + p3) / (p2 + p4))
    
  } else {
    return(build_general_umap() + ggtitle("General UMAP Layout"))
  }
}


