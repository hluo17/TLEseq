# SECTION 1: LOAD & PREPARE THE MAIN SEURAT OBJECT                           #
###############################################################################

dat <- readRDS("/data/MegaData_v8_annotated_smaller_trimmed.rds")

# Set default assay to Xenium
DefaultAssay(dat) <- "Xenium"

# The app only needs the FOV names from the images slot (spatial coordinates
# come from precomputed_app_data.rds), so keep the names and drop the images.
# This also avoids the Seurat bug where JoinLayers validates FOV boundaries
# even though images are unrelated to layer joining.
fov_names <- names(dat@images)
dat@images <- list()

# Nothing below reads anything except the normalized "data" layer of the
# Xenium assay, the UMAP and the metadata, so the rest is dropped to cut
# memory use. Each removal is tried on a copy and kept only if the Xenium
# assay and the UMAP are still intact; a Seurat version that handles one of
# them differently just leaves that piece in memory.
drop_if_safe <- function(obj, label, drop_fn) {
  tryCatch({
    out <- drop_fn(obj)
    stopifnot(identical(dim(out[["Xenium"]]), dim(obj[["Xenium"]])),
              "umap" %in% Reductions(out))
    out
  }, error = function(e) {
    message("Not dropped (", label, "): ", conditionMessage(e))
    obj
  })
}

# Other assays, graphs and non-UMAP reductions go first, so they are already
# out of memory during the join / normalize peak.
for (.a in setdiff(Assays(dat), "Xenium"))
  dat <- drop_if_safe(dat, paste("assay", .a), function(x) { x[[.a]] <- NULL; x })
for (.g in Graphs(dat))
  dat <- drop_if_safe(dat, paste("graph", .g), function(x) { x[[.g]] <- NULL; x })
for (.r in setdiff(Reductions(dat), "umap"))
  dat <- drop_if_safe(dat, paste("reduction", .r), function(x) { x[[.r]] <- NULL; x })

dat <- JoinLayers(dat)
dat <- NormalizeData(dat, assay = "Xenium")
dat <- JoinLayers(dat)

# Raw counts (and scaled data, if present) were only needed to normalize.
for (.l in setdiff(Layers(dat[["Xenium"]]), "data"))
  dat <- drop_if_safe(dat, paste("layer", .l), function(x) {
    LayerData(x, assay = "Xenium", layer = .l) <- NULL
    x
  })

rm(.a, .g, .r, .l)
invisible(gc())
message("Seurat object in memory: ", format(object.size(dat), units = "GB"))


