apply_plotting_factors <- function(dat, sample_order) {
  if ("type"     %in% colnames(dat@meta.data))
    dat$type <- factor(dat$type, levels = c("epilepsy", "postmortem"))
  if ("Sample"   %in% colnames(dat@meta.data))
    dat$Sample <- factor(dat$Sample, levels = sample_order)
  if ("celltype" %in% colnames(dat@meta.data))
    dat$celltype <- factor(dat$celltype,
                           levels = c("ExN","InN","Astro","Micro",
                                      "Oligo","OPC","Vascular","CSF"))
  return(dat)
}

